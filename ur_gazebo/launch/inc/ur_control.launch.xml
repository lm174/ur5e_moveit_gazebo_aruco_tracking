<?xml version="1.0"?>
<launch>
<!--
这个文件模拟UR机器人驱动：接收参数，启动“仿真驱动”（Gazebo）+ ros_control控制器。
部分参数和真实ur_robot_driver保持一致；另一部分是Gazebo仿真专属。
在这里完成模型生成与控制器加载，gazebo_ros_control替代真实机器人驱动。
-->

<!-- ========= 和ur_robot_driver共用的控制器参数 ========= -->
<arg name="controller_config_file" doc="Config file used for defining the ROS-Control controllers."/>
<!-- 默认启动的控制器 -->
<arg name="controllers" default="joint_state_controller eff_joint_traj_controller"/>
<!-- 加载但不启动的控制器 -->
<arg name="stopped_controllers" default="joint_group_eff_controller"/>

<!-- ========= Gazebo仿真参数 ========= -->
<env name="GAZEBO_MODEL_PATH" value="$(find ur5e_gazebo)/models:$(optenv GAZEBO_MODEL_PATH)"/>
<arg name="gazebo_model_name" default="robot" doc="Gazebo里模型的名字，spawn之后在Gazebo中显示的model名称" />
<arg name="gazebo_world" default="$(find ur5e_gazebo)/worlds/gazebo.world" doc="要加载的.world场景文件" />
<arg name="gui" default="true" doc="true启动Gazebo图形界面；false只启动gazebo_server后台仿真" />
<arg name="paused" default="false" doc="true：Gazebo启动后暂停仿真；false加载完成立刻运行仿真" />
<arg name="robot_description_param_name" default="robot_description" doc="参数服务器中存放URDF模型的参数名" />
<arg name="spawn_z" default="0.1" doc="模型生成的Z轴高度。注意：值太小会让机器人和地面碰撞" />
<arg name="start_gazebo" default="true" doc="true：本launch启动Gazebo；false：Gazebo已经在外部提前启动好了" />

<!-- ========= 机械臂初始关节角度 ========= -->
<arg name="initial_joint_positions" default=" -J shoulder_pan_joint 0.0  -J shoulder_lift_joint -1.57 -J elbow_joint 0.0 -J wrist_1_joint -1.57 -J wrist_2_joint 0.0 -J wrist_3_joint 0.0" doc="Initial joint configuration of the robot"/>

<!-- 加载控制器yaml参数到参数服务器 -->
<rosparam file="$(arg controller_config_file)" command="load"/>

<!-- 如果start_gazebo=true，则启动Gazebo，加载world场景 -->
<include file="$(find gazebo_ros)/launch/empty_world.launch" if="$(arg start_gazebo)">
<arg name="world_name" value="$(arg gazebo_world)"/>
<arg name="paused" value="$(arg paused)"/>
<arg name="gui" value="$(arg gui)"/>
</include>

<!-- ========= spawn_model：把URDF模型送入Gazebo！ ========= -->
<node name="spawn_gazebo_model" pkg="gazebo_ros" type="spawn_model"
args="
      -urdf
      -param $(arg robot_description_param_name)
      -model $(arg gazebo_model_name)
      -z $(arg spawn_z)
      $(arg initial_joint_positions)
      "
output="screen" respawn="false" />

<!-- 启动控制器管理器，启动指定控制器 -->
<node name="ros_control_controller_spawner" pkg="controller_manager" type="spawner"
args="$(arg controllers)" output="screen" respawn="false" />

<!-- 加载其余控制器，但是不启动（topped） -->
<node name="ros_control_stopped_spawner" pkg="controller_manager" type="spawner"
args="--stopped $(arg stopped_controllers)" output="screen" respawn="false" />
</launch>
